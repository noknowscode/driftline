<Page x:Class="Liveline.Demo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:liveline="using:Liveline"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Chart card -->
    <Border Grid.Column="0"
            CornerRadius="16"
            Width="520"
            Height="300"
            Translation="0,0,24">
      <Border.Shadow>
        <ThemeShadow />
      </Border.Shadow>

      <liveline:LivelineChart x:Name="Chart"
                               ShowGrid="True"
                               ShowBadge="True"
                               ShowFill="True"
                               LerpSpeed="0.04" />
    </Border>

    <!-- Side panel -->
    <Border Grid.Column="1"
            Margin="16,0,0,0"
            Padding="20,24"
            CornerRadius="16"
            Width="200"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Translation="0,0,8">
      <Border.Shadow>
        <ThemeShadow />
      </Border.Shadow>

      <StackPanel Spacing="20">

        <!-- Header -->
        <TextBlock Text="Settings"
                   Style="{StaticResource TitleSmall}"
                   Opacity="0.7" />

        <!-- Features section -->
        <StackPanel Spacing="4">
          <TextBlock Text="FEATURES"
                     Style="{StaticResource LabelSmall}"
                     Opacity="0.4"
                     Margin="0,0,0,4" />

          <ToggleSwitch x:Name="GridToggle"
                        Header="Grid lines"
                        IsOn="True"
                        Toggled="OnToggleChanged" />
          <ToggleSwitch x:Name="BadgeToggle"
                        Header="Value badge"
                        IsOn="True"
                        Toggled="OnToggleChanged" />
          <ToggleSwitch x:Name="FillToggle"
                        Header="Gradient fill"
                        IsOn="True"
                        Toggled="OnToggleChanged" />
          <ToggleSwitch x:Name="MomentumToggle"
                        Header="Live dot"
                        IsOn="True"
                        Toggled="OnToggleChanged" />
        </StackPanel>

        <!-- Playback section -->
        <StackPanel Spacing="4">
          <TextBlock Text="PLAYBACK"
                     Style="{StaticResource LabelSmall}"
                     Opacity="0.4"
                     Margin="0,0,0,4" />

          <ToggleSwitch x:Name="PauseToggle"
                        Header="Paused"
                        IsOn="False"
                        Toggled="OnToggleChanged" />
          <ToggleSwitch x:Name="DarkToggle"
                        Header="Dark mode"
                        IsOn="True"
                        Toggled="OnToggleChanged" />
        </StackPanel>

        <!-- Color section -->
        <StackPanel Spacing="8">
          <TextBlock Text="ACCENT COLOR"
                     Style="{StaticResource LabelSmall}"
                     Opacity="0.4"
                     Margin="0,0,0,4" />

          <utu:AutoLayout Spacing="8"
                          Orientation="Horizontal"
                          PrimaryAxisAlignment="Center">
            <Button Tag="#4CAF50" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Green">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#4CAF50" />
            </Button>
            <Button Tag="#2196F3" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Blue">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#2196F3" />
            </Button>
            <Button Tag="#FF9800" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Orange">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#FF9800" />
            </Button>
            <Button Tag="#9C27B0" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Purple">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#9C27B0" />
            </Button>
            <Button Tag="#F44336" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Red">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#F44336" />
            </Button>
            <Button Tag="#009688" Click="OnColorPreset"
                    Width="28" Height="28" MinWidth="0" MinHeight="0"
                    Padding="0" CornerRadius="14"
                    ToolTipService.ToolTip="Teal">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="#009688" />
            </Button>
          </utu:AutoLayout>
        </StackPanel>

      </StackPanel>
    </Border>

  </Grid>
</Page>
